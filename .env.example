# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://wqdacfrzurhpsiuvzxwo.supabase.co
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vercel Cron Secret (for scheduled jobs)
CRON_SECRET=your_cron_secret_here

# Site URL (for server actions)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional local override for neutral suite captures. On Adam's Mac, Understood
# otherwise uses Harness's iCloud Documents/Harness Captures/Understood/Pending directory.
# This must be an absolute directory and must never point at /accepted.
HARNESS_CAPTURE_INBOX=

# Authenticated Vercel-to-Harness capture outbox. The token is server-only and
# the user ID pins the bridge to Adam's owned entry records.
HARNESS_BRIDGE_TOKEN=
HARNESS_BRIDGE_USER_ID=

# Web Push (VAPID keys for push notifications)
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
